CODEPLAG_DEVICE=cpu
CODEPLAG_MODEL_NAME=microsoft/unixcoder-base
CODEPLAG_LOG_LEVEL=INFO

# --- Web (docker compose up) ---
# Folder with best.pt + combiner.json, mounted read-only into the worker.
CODEPLAG_CHECKPOINTS=./models/checkpoints
CODEPLAG_WEB_REDIS_URL=redis://redis:6379/0
CODEPLAG_WEB_JOBS_DIR=/data/jobs
CODEPLAG_WEB_MAX_FILES=200
CODEPLAG_WEB_MAX_FILE_BYTES=524288
CODEPLAG_WEB_MAX_TOTAL_BYTES=20971520
CODEPLAG_WEB_JOB_TTL_SECONDS=86400
CODEPLAG_WEB_CORS_ORIGINS=["http://localhost:3000"]
CODEPLAG_WEB_NEURAL_BATCH=32
NEXT_PUBLIC_API_URL=http://localhost:8000
WORKER_REPLICAS=1
